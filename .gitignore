# Root-level gitignore -- covers shared/, scripts/, and CI artifacts.
# Each Problem*/ folder also has its own .gitignore for its own concerns
# (raw data, notebook checkpoints, etc.) -- this one is for the new
# root-level hardening additions.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# Test / CI
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv
venv/
env/

# OS
.DS_Store
Thumbs.db
