# Root-level gitignore -- covers shared/, scripts/, and CI artifacts.
# Each Problem*/ folder also has its own .gitignore for its own concerns
# (raw data, notebook checkpoints, etc.) -- this one is for the new
# root-level hardening additions.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# Test / CI
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv
venv/
env/

# OS
.DS_Store
Thumbs.db

# Secrets hardening (2026-09-08) -- never commit real credentials/keys.
# .example templates are still committed intentionally.
.env.*
!.env.example
!**/.env.example
*.pem
*.key
!**/*.key.example
*.pfx
*.p12
.aws/
.ssh/
**/secrets/
**/*_secret*
**/*credentials*
!**/*credentials*.example
