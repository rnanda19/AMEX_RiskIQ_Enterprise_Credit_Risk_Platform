# Copy to .env (same folder as severity_scoring_service.py) and fill in real values before running.
# Never commit a real .env file -- .gitignore already excludes it.

# Optional. The frozen severity bundle ships self-contained alongside this file
# (severity_scoring_bundle.json) -- only set this if you're pointing at a different bundle.
# AMEX_SEVERITY_BUNDLE_PATH=/path/to/severity_scoring_bundle.json

# Required to call any endpoint below /health. Falls back to a published, public dev-only
# default (dev-only-CHANGE-ME-before-deploying) if unset -- fine for local dev, never for
# anything reachable by anyone else.
API_KEY=dev-only-CHANGE-ME-before-deploying
