# Copy to .env (same folder as real_time_alert_service.py) and fill in real values before
# running. Never commit a real .env file -- .gitignore already excludes it.

# Optional. Defaults to this repo's own self-contained copy of the frozen policy JSON, shipped
# alongside this file. Only set this if you're pointing at a different policy file.
# AMEX_EWS_POLICY_PATH=/path/to/early_warning_deployment_policy.json

# Required to call any endpoint below /health. Falls back to a published, public dev-only
# default (dev-only-CHANGE-ME-before-deploying) if unset -- fine for local dev, never for
# anything reachable by anyone else.
API_KEY=dev-only-CHANGE-ME-before-deploying
