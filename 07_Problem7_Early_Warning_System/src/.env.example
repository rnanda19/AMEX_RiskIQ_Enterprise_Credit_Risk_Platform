# Copy to .env (same folder as real_time_alert_service.py) and fill in real values before
# running. Never commit a real .env file -- .gitignore already excludes it.

# Optional. Defaults to this repo's own self-contained copy of the frozen policy JSON, shipped
# alongside this file. Only set this if you're pointing at a different policy file.
# AMEX_EWS_POLICY_PATH=/path/to/early_warning_deployment_policy.json

# Required to call /score or /model-info -- but not directly as a header anymore. This value is
# now used two ways by the OAuth2/JWT pilot (see AUTH_HARDENING.md):
#   1. As the `client_secret` you POST to /token (with client_id=ews-service-client,
#      grant_type=client_credentials) to get a short-lived bearer token.
#   2. As the HS256 signing key for that token (a real production setup would use a separate
#      signing key -- this pilot deliberately reuses the one secret to avoid needing new
#      infrastructure; see AUTH_HARDENING.md for the honest tradeoff).
# Falls back to a published, public dev-only default (dev-only-CHANGE-ME-before-deploying) if
# unset -- fine for local dev, never for anything reachable by anyone else.
API_KEY=dev-only-CHANGE-ME-before-deploying
