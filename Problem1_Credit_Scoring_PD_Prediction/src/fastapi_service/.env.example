# Copy to .env (same folder as main.py) and fill in real values before running this service.
# Never commit a real .env file -- .gitignore already excludes it.

# Required. Path to your own local AMEX_Enterprise_Credit_Risk_Platform folder (must contain
# artifacts/project_config.json and artifacts/notebook_05_summary.json, produced by running this
# platform's own notebooks). There is no repo-relative default: the real multi-GB champion model
# is not committed to this public repo (see models/README.md).
AMEX_PROJECT_ROOT=/path/to/your/AMEX_Enterprise_Credit_Risk_Platform

# Required to call any endpoint below /health. Falls back to a published, public dev-only
# default (dev-only-CHANGE-ME-before-deploying) if unset -- fine for a local uvicorn --reload
# session, never acceptable for anything reachable by anyone else. Generate a real value with,
# e.g., `python -c "import secrets; print(secrets.token_urlsafe(32))"` before deploying.
API_KEY=dev-only-CHANGE-ME-before-deploying
