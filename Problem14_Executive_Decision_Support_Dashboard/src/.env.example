# Copy to .env (same folder as executive_dashboard_service.py) and fill in real values before
# running. Never commit a real .env file -- .gitignore already excludes it.

# Optional. Defaults to this repo's own self-contained copies of the frozen policy JSON
# and the real platform-wide dashboard data, shipped alongside this file.
# AMEX_P14_POLICY_PATH=/path/to/executive_dashboard_deployment_policy.json
# AMEX_P14_DATA_PATH=/path/to/executive_dashboard_data.json

# Required to call any endpoint below /health. Falls back to a published, public dev-only
# default (dev-only-CHANGE-ME-before-deploying) if unset -- fine for local dev, never for
# anything reachable by anyone else.
API_KEY=dev-only-CHANGE-ME-before-deploying
