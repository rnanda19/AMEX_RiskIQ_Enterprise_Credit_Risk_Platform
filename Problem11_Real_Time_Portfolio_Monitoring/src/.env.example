# Copy to .env (same folder as portfolio_alert_feed_service.py) and fill in real values before
# running. Never commit a real .env file -- .gitignore already excludes it.

# Optional. Defaults to this repo's own self-contained copy of the frozen policy JSON,
# shipped alongside this file. Only set this if pointing at a different policy file.
# AMEX_P11_POLICY_PATH=/path/to/portfolio_monitoring_deployment_policy.json

# Required to call any endpoint below /health. Falls back to a published, public dev-only
# default (dev-only-CHANGE-ME-before-deploying) if unset -- fine for local dev, never for
# anything reachable by anyone else.
API_KEY=dev-only-CHANGE-ME-before-deploying
