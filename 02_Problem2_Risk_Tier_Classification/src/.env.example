# Copy to .env (same folder as risk_tier_service.py) and fill in real values before running.
# Never commit a real .env file -- .gitignore already excludes it.

# Required. Path to your own local AMEX_Enterprise_Credit_Risk_Platform folder. No repo-relative
# default: the real multi-GB champion model is not committed to this public repo (see
# models/README.md).
AMEX_PROJECT_ROOT=/path/to/your/AMEX_Enterprise_Credit_Risk_Platform

# Required to call any endpoint below /health. Falls back to a published, public dev-only
# default (dev-only-CHANGE-ME-before-deploying) if unset -- fine for local dev, never for
# anything reachable by anyone else.
API_KEY=dev-only-CHANGE-ME-before-deploying
